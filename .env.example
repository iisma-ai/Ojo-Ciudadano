# Copia este fichero a .env y rellena los valores. .env nunca se sube.
# Asistente: OpenRouter, en prueba para elegir modelo (D-010, docs/decisions.md).
# Comprobar la clave: uv run python -m ojo_ciudadano.asistente.openrouter
OPENROUTER_API_KEY=
LLM_MODEL=
# Ruta de la base analítica local
DUCKDB_PATH=data/ojo_ciudadano.duckdb

# Sal secreta para seudonimizar a las personas físicas (D-007). Debe ser la misma en todo
# el equipo. Si se deja vacía se genera una local en data/.sal_seudonimos.
SEUDONIMO_SAL=
